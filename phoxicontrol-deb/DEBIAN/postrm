#!/bin/bash
set -e

INSTALL_DIR="/opt/Photoneo/PhoXiControl-1.16.4"
ENV_FILE="/etc/profile.d/phoxicontrol.sh"

case "$1" in
    remove|purge)
        echo "Removing PhoXiControl..."

        if [ -d "$INSTALL_DIR" ]; then
            exec "$INSTALL_DIR/uninstall.sh" || true
            rmdir /opt/Photoneo 2>/dev/null || true
        fi

        if [ -f "$ENV_FILE" ]; then
            rm -f "$ENV_FILE"
        fi

        echo "PhoXiControl removed."
        ;;
esac

exit 0
